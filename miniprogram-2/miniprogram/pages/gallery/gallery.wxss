/*  1. 基础容器与背景  */
page { height: 100vh; overflow: hidden; }
.container { height: 100vh; display: flex; flex-direction: column; position: relative; }

.page-bg-wrapper { position: fixed; inset: 0; z-index: -1; }
.page-bg { width: 100%; height: 100%; object-fit: cover; }

/*  2. 顶部统计区 (居中对齐)  */
.fixed-top { 
  padding: 40rpx 32rpx 10rpx; 
  z-index: 10; 
  display: flex;
  justify-content: center; 
}

.header-card {
  width: 380rpx;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 32rpx;
  display: flex;
  padding: 24rpx 0;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.02);
}

.info-box { flex: 1; display: flex; flex-direction: column; align-items: center; }
.num { font-size: 36rpx; font-weight: bold; color: #F07BCD; }
.label { font-size: 20rpx; color: #888; margin-top: 4rpx; }
.line { width: 2rpx; height: 50rpx; background: rgba(240, 123, 205, 0.1); }

/*  3. 内容滚动区 (对齐 Daily 322rpx 宽度)  */
.main-scroll { flex: 1; height: 0; }

.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 220rpx 32rpx 360rpx; 
}

.art-card {
  width: 322rpx; /* 精准对齐画册卡片宽度 */
  background: rgba(255, 255, 255, 0.4);
  border: 4rpx solid #fff;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.03);
  transition: transform 0.2s ease;
}

.art-card.active { border-color: #F07BCD; transform: scale(0.97); }

.img-wrap { width: 100%; height: 322rpx; background: #f9f9f9; }
.card-img { width: 100%; height: 100%; display: block; object-fit: cover; }

/* 卡片内部勾选框 */
.check-box {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  background: rgba(255,255,255,255，0.6);
  display: flex;
  justify-content: center;
  align-items: center;
}
.check-box.checked { background: #F07BCD; border: none; }
.inner-tick {
  width: 18rpx; height: 10rpx; border-left: 4rpx solid #fff; border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg); margin-top: -4rpx;
}

/* 文字信息 */
.card-info { padding: 20rpx; }
.title { 
  font-size: 28rpx; color: #374151; font-weight: 500; 
  display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.tag-box { margin-top: 12rpx; }
.tag { 
  font-size: 24rpx; color: #00B8DB; background: #ECFEFF; 
  padding: 6rpx 14rpx; border-radius: 8rpx; 
}

/* ========= 4. 底部操作按钮 (保留配色) ========= */
.fixed-bottom-actions {
  position: fixed;
  inset: auto 0 0 0;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  padding: 28rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 24rpx;
  z-index: 100;
  box-shadow: 0 -8rpx 30rpx rgba(0,0,0,0.05);
}

.btn-redo, .btn-submit {
  flex: 1; height: 112rpx; border-radius: 20rpx;
  font-size: 32rpx; font-weight: bold;
  display: flex; align-items: center; justify-content: center; gap: 14rpx;
}

/* 白底粉边 */
.btn-redo {
  border: 4rpx solid #FFBEE3;
  color: #FF99D7;
  background: #FFFFFF;
}

/* 粉色渐变 */
.btn-submit {
  background: linear-gradient(135deg, #F07BCD 0%, #F6B0E1 100%);
  color: #FFFFFF;
}

.btn-submit.btn-disabled { opacity: 0.4; }
.btn-icon { width: 44rpx; height: 44rpx; }

/* 全选按钮内的圆圈样式 */
.style-checkbox {
  width: 38rpx; height: 38rpx; border: 4rpx solid #FFBEE3; border-radius: 50%;
  position: relative;
}
.style-checkbox.is-checked { background: #FFBEE3; }
.style-checkbox .check-mark {
  position: absolute; width: 16rpx; height: 9rpx;
  border-left: 3rpx solid #fff; border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg); top: 10rpx; left: 9rpx;
}

.empty-hint {
  width: 100%; text-align: center; padding-top: 250rpx; color: #999; font-size: 28rpx; line-height: 1.8;
}