<view class="page">
  <view class="hero">
    <text class="hero-title">家长指南</text>
    <text class="hero-subtitle">给日常亲子沟通的简明支持建议</text>
  </view>

  <view class="list">
    <block wx:for="{{sections}}" wx:key="title">
      <view class="card">
        <text class="card-title">{{item.title}}</text>
        <text class="card-desc">{{item.desc}}</text>
      </view>
    </block>
  </view>

  <view class="footer">
    <view class="back-btn" bindtap="onBack">返回</view>
  </view>
</view>
