.page-bg-wrapper {
  position: fixed;
  inset: 0;
  z-index: -1;
}

.page-bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 1;
}
.status-section {
  height: 360rpx;              /* 控制顶部渐变区域高度 */
  display: flex;
  flex-direction: column;
  justify-content: center;     /* 垂直居中 */
  align-items: center;         /* 水平居中 */
  text-align: center;
}

.success-icon-wrap {
  margin-bottom: 24rpx;
}

.status-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 12rpx;
}

.status-sub {
  font-size: 26rpx;
  color: #6B7280;
}

/* 状态区*/
.content-inner {
  padding: 0 32rpx;
}

.glass-card {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-radius: 28rpx;
  border: 4rpx solid rgba(255, 255, 255);
  padding: 48rpx 40rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.card-label {
  font-size: 28rpx;
  color: #888;
}

.edit-icon {
  width: 44rpx;
  height: 44rpx;
}

.result-textarea {
  font-size: 32rpx;
  color: #374151;
  width: 100%;
  line-height: 32rpx;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #BCBCBC;
  margin-top: rpx;
}

.style-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  margin: 48rpx 0 16rpx;
}

.style-card {
  background: rgba(255, 255, 255, 0.4);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  border: 4rpx solid rgba(255, 255, 255);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
}

/* 选中状态 */
.style-active {
  border: 4rpx solid #F07BCD;
  background: linear-gradient(
    135deg,
    #FDF0F8 0%,
    #FCE6F4 100%
  );
}

/* 图片 */
.style-img {
  width: 244rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* 文字区域 */
.style-info {
  flex: 1;
  margin-left: 24rpx;
}

/* 默认标题灰色 */
.style-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #6B7280;
}

/* 选中才粉色 */
.style-active .style-name {
  background: linear-gradient(135deg, #F07BCD 0%, #F6B0E1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.style-desc {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 16rpx;
}

.style-tag {
  display: inline-block;
  background: #ECFEFF;
  color: #00B8DB;
  font-size: 24rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  margin-top: 16rpx;
}

.style-radio {
  width: 32rpx;
  height: 32rpx;
  margin-left: 24rpx;
}

/*  底部操作按钮*/
.fixed-bottom-actions {
  position: fixed;
  inset: auto 0 0 0;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  padding: 28rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 24rpx;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.08);
}

.btn-redo,
.btn-submit {
  flex: 1;
  height: 112rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.btn-redo {
  border: 4rpx solid #FFBEE3;
  color: #FF99D7;
  background: #FFFFFF;
}

.btn-submit {
  background: linear-gradient(135deg, #F07BCD 0%, #F6B0E1 100%);
  color: #FFFFFF;
}

.btn-icon {
  width: 44rpx;
  height: 44rpx;
}