/* --- 1. 全局配置 --- */

.container {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* --- 2. 背景图片 --- */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1; 
}

/* --- 3. 内容布局 --- */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
  position: relative;
  /* 确保主内容区不会挡住 fixed 定位的底栏 */
  padding-bottom: 200rpx; 
}

.illustration-placeholder {
  height: 320rpx; 
  width: 100%;
}

.text-group {
  text-align: center;
  margin-top: 56rpx;
}

.main-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #374151;
  margin-bottom: 24rpx;
}

.description {
  font-size: 32rpx;
  color: #6B7280;
  line-height: 1.8;
}

/* --- 4. 语音按钮区域 --- */
.voice-section {
  margin-top: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 100%;
  /* 调低层级，避免其隐形的热区（margin/padding）覆盖到底栏 */
  z-index: 1; 
}

.mic-wrapper {
  width: 220rpx;
  height: 220rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  transition: all 0.2s ease;
}

.mic-inner-gradient {
  width: 170rpx;
  height: 170rpx;
  background: linear-gradient(135deg, #FF99D7 0%, #F07BCD 100%);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 12rpx 40rpx rgba(240, 123, 205, 0.4);
}

.mic-icon {
  width: 80rpx;
  height: 80rpx;
}

/* 点击反馈 */
.mic-hover {
  transform: scale(0.92);
}

.mic-hover .mic-wrapper {
  background: rgba(255, 255, 255, 0.5);
}

.hint-text {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #999999;
}

.hint-icon {
  width: 32rpx;
  height: 32rpx;
}

/* --- 5. 底部导航栏 --- */
.tab-bar-custom {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 180rpx; 
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  display: flex;
  justify-content: space-around;
  align-items: flex-start; 
  padding-top: 20rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 4rpx solid rgba(255, 255, 255);
  z-index: 9999; 
}

.tab-item {
  width: 160rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 55rpx; 
  transition: all 0.2s ease-in-out;
  /* 增加点击灵敏度 */
  pointer-events: auto; 
}

/* 选中态：粉色背景胶囊 */
.tab-item.is-active {
  background: #FCE5F5;
}

.tab-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tab-img {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 6rpx;
}

.tab-text {
  font-size: 24rpx;
  color: #999999; 
}

.tab-item.is-active .tab-text {
  color: #F07BCD;
  font-weight: bold;
}

/* 装饰波纹 */
.wave-decoration {
  position: absolute;
  width: 100rpx;
  height: 4rpx;
  background: rgba(240, 123, 205, 0.2);
  border-radius: 2rpx;
  z-index: -1; /* 波纹不要挡住按钮 */
}
.wave-decoration.left { left: 40rpx; }
.wave-decoration.right { right: 40rpx; }