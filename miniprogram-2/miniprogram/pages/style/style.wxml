<view class="container">
  <view class="page-bg-wrapper">
    <image class="page-bg" src="/assets/images/儿童沟通辅助小程序 1.png" mode="aspectFill" />
  </view>

  <view class="status-section">
    <view class="success-icon-wrap">
      <image class="success-icon" src="/assets/icons/success_pink.png" mode="aspectFit" />
    </view>
    
    <view class="glass-card">
      <view class="card-header">
        <text class="card-label">当前选择</text>
      </view>
      <view class="result-textarea">
        <text>{{selectedStyleName || '卡通风格'}}</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="content-scroll">
    <view class="content-inner">
      <view class="style-title">请选择绘画风格</view>

      <block wx:for="{{styleOptions}}" wx:key="id">
        <view 
          class="style-card {{selectedStyle === item.id ? 'style-active' : ''}}"
          bindtap="selectStyle"
          data-style="{{item.id}}"
          data-name="{{item.name}}"
        >
          <image class="style-img" src="{{item.img}}" mode="aspectFill" />
          
          <view class="style-info">
            <view class="style-name">{{item.name}}</view>
            <view class="style-desc">{{item.desc}}</view>
            <view class="style-tag">适合3-5岁</view>
          </view>

          <view class="style-checkbox-wrap">
             <view class="style-checkbox {{selectedStyle === item.id ? 'is-checked' : ''}}">
               <view class="check-mark" wx:if="{{selectedStyle === item.id}}"></view>
             </view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="fixed-bottom-actions">
    <view class="btn-redo" bindtap="onBack">
      <image class="btn-icon" src="/assets/icons/redo.png" mode="aspectFit" />
      <text>返回</text>
    </view>

    <view class="btn-submit" bindtap="onConfirm">
      <image class="btn-icon" src="/assets/icons/check_white.png" mode="aspectFit" />
      <text>确认</text>
    </view>
  </view>
</view>