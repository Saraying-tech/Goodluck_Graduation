/* --- 1. 页面基础 --- */
.container {
  min-height: 100vh;
  position: relative;
  box-sizing: border-box;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.page-bg-wrapper {
  position: fixed;
  inset: 0;
  z-index: -1;
}

.page-bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* --- 2. 顶部状态区 (居中布局) --- */
.status-section {
  padding-top: 40rpx; /* 稍微留一点顶部距离，不至于太挤 */
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.success-icon-wrap {
  margin-bottom: 16rpx;
}

.success-icon {
  width: 100rpx;
  height: 100rpx;
}

/* 核心：当前选择卡片 (挪上一点) */
.glass-card {
  width: 600rpx;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-radius: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  padding: 30rpx 40rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
  margin-top: -10rpx;    /* 稍微往上提 */
  margin-bottom: 20rpx;  /* 缩小这个值，下方的列表就会挪上来 */
}

.card-header {
  display: flex;
  justify-content: center;
  margin-bottom: 8rpx;
}

.card-label {
  font-size: 26rpx;
  color: #888;
}

.result-textarea {
  font-size: 36rpx;
  font-weight: bold;
  color: #f07bcd;
}

/* --- 3. 列表标题 --- */
.content-inner {
  padding: 0 32rpx;
}

.style-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  margin: 10rpx 0 20rpx; /* 减小标题间距 */
}

/* --- 4. 风格卡片列表 --- */
.style-card {
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  border: 4rpx solid rgba(255, 255, 255);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
}

.style-active {
  border: 4rpx solid #F07BCD;
  background: linear-gradient(135deg, #FDF0F8 0%, #FCE6F4 100%);
}

.style-img {
  width: 244rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.style-info {
  flex: 1;
  margin-left: 24rpx;
}

.style-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #6B7280;
}

.style-active .style-name {
  background: linear-gradient(135deg, #F07BCD 0%, #F6B0E1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  color: #F07BCD;
}

.style-desc {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 10rpx;
}

.style-tag {
  display: inline-block;
  background: #ECFEFF;
  color: #00B8DB;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-top: 10rpx;
}

/* --- 5. 粉色渐变勾选框 --- */
.style-checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  background: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
}

.style-checkbox.is-checked {
  background: linear-gradient(135deg, #F07BCD 0%, #F6B0E1 100%);
  border: none;
}

.check-mark {
  width: 18rpx;
  height: 10rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

/* --- 6. 底部固定操作按钮 --- */
.fixed-bottom-actions {
  position: fixed;
  inset: auto 0 0 0;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  padding: 28rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 24rpx;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.btn-redo, .btn-submit {
  flex: 1;
  height: 112rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.btn-redo {
  border: 4rpx solid #FFBEE3;
  color: #FF99D7;
  background: #FFFFFF;
}

.btn-submit {
  background: linear-gradient(135deg, #F07BCD 0%, #F6B0E1 100%);
  color: #FFFFFF;
}

.btn-icon {
  width: 44rpx;
  height: 44rpx;
}