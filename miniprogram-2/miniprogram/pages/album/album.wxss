/*页面基础*/
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 200rpx;
}

/* 背景 */
.page-bg-wrapper {
  position: fixed;
  inset: 0;
  z-index: -1;
}

.page-bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 结果卡片 */

.result-card {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 28rpx;
  border: 4rpx solid rgba(255, 255, 255);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.result-image {
  width: 100%;
  height: 320rpx;
}

.result-content {
  padding: 32rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #374151;
}

/* 时间 */
.result-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.time-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.time-text {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 28rpx;
}

/* 标签 */
.tag-row {
  display: flex;
  gap: 16rpx;
}

.tag {
  padding: 10rpx 24rpx;
  border-radius: 9rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 蓝色标签 */
.tag:nth-child(1) {
  background: #EFF6FF;
  color: #2B7FFF;
}

/* 粉色标签 */
.tag:nth-child(2) {
  background: #ECFEFF;
  color: #00B8DB;
}

/*反馈区*/

.feedback-section {
  margin-top: 48rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 400;
  margin-bottom: 24rpx;
  color: #1F2937;
}

/* 表情网格 */
.emoji-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28rpx;
}

/* 表情卡片 */
.emoji-card {
  background: rgba(255, 255, 255, 0.4);
  border-radius: 24rpx;
  padding: 32rpx 12rpx;
  border: 4rpx solid rgba(255, 255, 255);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}

/* 表情图标 */
.emoji-icon {
  width: 84rpx;
  height: 84rpx;
  margin-bottom: 16rpx;
  transition: transform 0.25s ease;
}

/* 表情文字 */
.emoji-label {
  font-size: 28rpx;
  color: #374151;
}

/* 选中状态 */
.emoji-card.active {
  border-color: #F07BCD;
  background: linear-gradient(
    135deg,
    rgba(240,123,205,0.18) 0%,
    rgba(246,176,225,0.28) 100%
  );
  box-shadow: 0 8rpx 24rpx rgba(240,123,205,0.25);
}

.emoji-card.active .emoji-icon {
  transform: scale(1.12);
}

.emoji-card.active .emoji-label {
  color: #F07BCD;
  font-weight: 600;
}

/*底部按钮 */

.fixed-bottom-actions {
  position: fixed;
  inset: auto 0 0 0;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  padding: 32rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 28rpx;
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.08);
}

.btn-redo,
.btn-submit {
  flex: 1;
  height: 112rpx;
  border-radius: 28rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

/* 次按钮 */
.btn-redo {
  border: 4rpx solid #FFBEE3;
  color: #FF99D7;
  background: #FFFFFF;
}

/* 主按钮 */
.btn-submit {
  background: linear-gradient(135deg, #F07BCD 0%, #F6B0E1 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(240,123,205,0.35);
}

.btn-icon {
  width: 44rpx;
  height: 44rpx;
}